{
  "name": "fotomatic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:clean": "rm -rf .next/dev",
    "dev:kill-ports": "sh -c 'for p in 3000 3001; do lsof -ti:$p | xargs kill -9 2>/dev/null || true; done'",
    "dev:reset": "npm run dev:kill-ports && npm run dev:clean",
    "dev": "npm run dev:clean && next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "firebase": "^12.12.1",
    "firebase-admin": "^13.6.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.3",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@8.6.0+sha512.b8c69619796f1be9b934825a47824411e9c285b83ed403f8cd5a6ab383c4719838b87fa55cc4ddfd7fe58ab29903e4c2d30d1dfbefb2ddbb4835cc322acbb000"
}
