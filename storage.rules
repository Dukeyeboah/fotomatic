// Firebase Storage security rules for Fotomatic.
// Deploy (Firebase CLI): firebase deploy --only storage
// Paths must match lib/firebase/upload.ts → photographer-media/{uid}/...
//
// Photographers may upload images only under their own uid; admins may manage any.
// Public read allows directory / profile pages to show photos via download URLs.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /photographer-media/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.uid == userId || isAdmin())
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Site marketing assets (logos, hero art). Upload via Console / CI; app reads only.
    match /fotomatic-images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
